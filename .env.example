# ---------- Chain RPC ----------
ETHEREUM_SEPOLIA_RPC=
BASE_SEPOLIA_RPC=

# ---------- Deployer keys ----------
# Use chain-specific keys; ops.sh maps these into PRIVATE_KEY per command.
ETHEREUM_SEPOLIA_DEPLOYER_KEY=
BASE_SEPOLIA_DEPLOYER_KEY=

# ---------- CCIP routers ----------
ETHEREUM_SEPOLIA_CCIP_ROUTER=
BASE_SEPOLIA_CCIP_ROUTER=
MOCK_CCIP_ROUTER=
ETHEREUM_SEPOLIA_LINK=0x779877A7B0D9E8603169DdbD7836e478b4624789
BASE_SEPOLIA_LINK=0xE4aB69C077896252FAFBD49EFD26B5D171A32410
LINK_TOKEN=

# ---------- Optional workflow/demo keys ----------
WORKFLOW_PRIVATE_KEY=
USER_PRIVATE_KEY=
MINTER_PRIVATE_KEY=
OPERATOR_PRIVATE_KEY=
CLAIMER_PRIVATE_KEY=
BRIDGE_ADMIN_PRIVATE_KEY=

# ---------- Optional role addresses ----------
WORKFLOW=
REPORTER=

# ---------- Optional: reuse pre-deployed collateral/debt/oracle ----------
# If COLLATERAL_ASSET and DEBT_ASSET are set, DeployLendingStack will not deploy MockERC20 tokens.
# If PRICE_ORACLE is set, DeployLendingStack will reuse it. Set SET_ORACLE_PRICES=true only if deployer can write prices.
COLLATERAL_ASSET=
DEBT_ASSET=
PRICE_ORACLE=
SET_ORACLE_PRICES=false

# ---------- Cross-chain selectors (required for cross-chain demo/ops) ----------
SOURCE_CHAIN_SELECTOR=
DEST_CHAIN_SELECTOR=

# ---------- Mock router programmable transfer wiring (optional) ----------
WIRE_MOCK_BRIDGE=true
CONFIGURE_MOCK_ROUTER=false
MOCK_BRIDGE_SOURCE_TOKEN=
MOCK_BRIDGE_DEST_TOKEN=

CRE_FORWARDER=
WF_EXPECTED_AUTHOR=