{
  "name": "reprieve-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Reprieve backend service (NestJS + Postgres)",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "lint": "eslint \"{src,test}/**/*.ts\" --max-warnings=0",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "backend:sync": "ts-node src/modules/positions/cli-sync.ts",
    "indexer:start": "ts-node src/modules/rescue-history/indexer-start.ts",
    "indexer:once": "ts-node src/modules/rescue-history/indexer-once.ts",
    "indexer:reset": "ts-node src/modules/rescue-history/indexer-reset.ts",
    "projection:rebuild": "ts-node src/modules/rescue-history/projection-rebuild.ts",
    "relay:start": "ts-node src/modules/relay/relay-start.ts",
    "relay:once": "ts-node src/modules/relay/relay-once.ts",
    "migration:run": "typeorm-ts-node-commonjs -d src/modules/persistence/data-source.ts migration:run",
    "migration:revert": "typeorm-ts-node-commonjs -d src/modules/persistence/data-source.ts migration:revert"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/typeorm": "^10.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.7",
    "ethers": "^6.15.0",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.15",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.10",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.2",
    "typeorm-ts-node-commonjs": "^0.3.20"
  }
}
