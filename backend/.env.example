NODE_ENV=development
APP_PORT=3001

# Database
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=reprieve
DB_PASSWORD=reprieve
DB_NAME=reprieve_backend
DB_SSL=false

# Chain RPCs (required)
ETHEREUM_SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_KEY
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Optional config overrides
CONTRACTS_CONFIG_DIR=./contracts-config
ETHEREUM_SEPOLIA_START_BLOCK=10379862
BASE_SEPOLIA_START_BLOCK=38413150
INDEXER_BLOCK_WINDOW=1000
INDEXER_CONFIRMATIONS=0
INDEXER_POLL_INTERVAL_MS=15000
PROJECTION_REBUILD_BATCH_SIZE=500
RELAY_POLL_INTERVAL_MS=15000
RELAY_BATCH_SIZE=5
RELAY_MAX_ATTEMPTS=5
RELAY_BACKOFF_BASE_MS=15000
RELAY_BACKOFF_MAX_MS=300000
RELAY_COMMAND_TIMEOUT_MS=240000
RELAY_SCAN_LIMIT=250
RELAY_RUNNING_STALE_MS=300000
# Relay signer key options:
# RELAY_SIGNER_PRIVATE_KEY=0x...
# ETHEREUM_SEPOLIA_PRIVATE_KEY=0x...
# BASE_SEPOLIA_PRIVATE_KEY=0x...

# Demo wallet onboarding
# Required to use demo-wallet APIs:
# DEMO_WALLET_MASTER_SECRET=replace-with-long-random-secret
# DEMO_WALLET_ENCRYPTION_KEY=0x<64-hex-chars>
DEMO_WALLET_DEFAULT_ETH_SEPOLIA_GAS_ETH=0.0001
DEMO_WALLET_DEFAULT_BASE_SEPOLIA_GAS_ETH=0.0001
DEMO_WALLET_DEFAULT_ETH_WETH=80
DEMO_WALLET_DEFAULT_ETH_USDC=90000
DEMO_WALLET_DEFAULT_BASE_WETH=50
DEMO_WALLET_DEFAULT_BASE_USDC=90000
# Optional override for repay bootstrap (opposite-direction compound market on base sepolia)
# DEMO_REPAY_BASE_COMPOUND_MARKET=0x...
SWAGGER_ENABLED=true
SWAGGER_PATH=docs

# Optional: disable DB init for isolated module tests
DB_DISABLE=false
